{
  "expo": {
    "name": "expo-camera-qr-reproducer",
    "slug": "expo-camera-qr-reproducer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "expo-camera-qr-reproducer",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.expocameraqrreproducer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# expo-camera GMS code scanner. R8 breaks launchScanner in release builds.\n-keep class com.google.android.gms.internal.mlkit_code_scanner.** { *; }\n-keep class com.google.mlkit.vision.codescanner.** { *; }\n-keep class com.google.mlkit.vision.barcode.** { *; }\n-keep class com.google.mlkit.common.** { *; }\n"
          }
        }
      ]
    ]
  }
}
